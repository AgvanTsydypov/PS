FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY user_web_backend /app/user_web_backend

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8011

CMD ["uvicorn", "user_web_backend.main:app", "--host", "0.0.0.0", "--port", "8011"]
