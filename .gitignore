# Pack-opening frame originals (heavy PNG source; only WebP is committed)
user_web_frontend/public/pack/frames/*.png

# Per-claim composed turntable frames — built on the fly by user_web_backend,
# served via /static/turntables/. Pure runtime cache; never commit.
user_web_backend/_turntable_cache/

# Card-reveal turntable frames — local fallback for the /pack-test demo only.
# The real /me flow composes per-claim frames on the fly under
# /static/turntables/{claim_id}/, so these 360 webp files are dev-only and
# don't need to live in git (re-bake bloats the diff with the entire set).
# Regenerate locally with:
#     python card_render/render_card.py --bake-template --step 1
#     # then run the per-claim compose against the bake (see card_render/README.md)
user_web_frontend/public/pack/card-frames/*.png
user_web_frontend/public/pack/card-frames/*.webp

# Blender card-render tooling (heavy binaries + scratch render output)
card_render/*.blend
card_render/*.blend1
card_render/PNG/*.png
card_render/textures/*
!card_render/PNG/.gitkeep
!card_render/textures/.gitkeep
# Baked turntable template (large light_NNNN.png sequence; the template.json
# is the only small file worth committing per-build, but we keep the whole
# folder out of git and rebuild it on demand via --bake-template).
card_render/template/

.claude/settings.local.json

card_render_template.tar.gz