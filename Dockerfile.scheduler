# ============================================================================
# Dockerfile for PolyStars Scheduler Service
# ============================================================================
# This image runs the daily data scheduler with cron
# ============================================================================

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    cron \
    curl \
    postgresql-client \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install the Chromium browser + its OS libraries used by the SVG->PNG card
# rasterizer (Playwright). The mint-queue cron worker runs in THIS image and
# renders the NFT card here, so without this the worker has no browser to
# launch and svg_to_png times out -> claims fail with "Playwright worker is
# dead". ``install-deps`` needs apt package lists, so it re-runs apt-get
# update internally.
RUN playwright install --with-deps chromium

# Chromium refuses to start as root with the default sandbox, and small
# /dev/shm in containers can crash it mid-screenshot. The rasterizer reads
# both of these env vars (see scripts/cardgen/rasterize.py).
ENV PLAYWRIGHT_NO_SANDBOX=1
ENV PLAYWRIGHT_CHROMIUM_ARGS=--disable-dev-shm-usage

# Copy application code
COPY scripts/ /app/scripts/
COPY sql/ /app/sql/
COPY .env /app/.env

# Create logs directory
RUN mkdir -p /app/logs

# Fix line endings and make scripts executable
RUN find /app/scripts/cron -type f -name "*.sh" -exec dos2unix {} \;

# Copy entrypoint script and fix line endings
COPY scripts/cron/docker-entrypoint-scheduler.sh /docker-entrypoint.sh
RUN dos2unix /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

# Healthcheck
HEALTHCHECK --interval=1h --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep cron || exit 1

# Start cron in foreground
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["cron", "-f"]
