generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model events {
  id                String    @id
  ticker            String?
  slug              String?
  title             String
  description       String?
  start_date        DateTime? @db.Timestamptz(6)
  creation_date     DateTime? @db.Timestamptz(6)
  end_date          DateTime? @db.Timestamptz(6)
  closed_time       DateTime? @db.Timestamptz(6)
  created_at        DateTime? @db.Timestamptz(6)
  updated_at        DateTime? @db.Timestamptz(6)
  image             String?
  icon              String?
  active            Boolean?  @default(false)
  closed            Boolean?  @default(false)
  archived          Boolean?  @default(false)
  new               Boolean?  @default(false)
  featured          Boolean?  @default(false)
  restricted        Boolean?  @default(false)
  neg_risk          Boolean?  @default(false)
  enable_order_book Boolean?  @default(false)
  volume            Decimal?  @default(0) @db.Decimal(20, 6)
  volume24hr        Decimal?  @default(0) @db.Decimal(20, 6)
  volume1wk         Decimal?  @default(0) @db.Decimal(20, 6)
  volume1mo         Decimal?  @default(0) @db.Decimal(20, 6)
  volume1yr         Decimal?  @default(0) @db.Decimal(20, 6)
  liquidity         Decimal?  @default(0) @db.Decimal(20, 6)
  open_interest     Decimal?  @default(0) @db.Decimal(20, 6)
  liquidity_amm     Decimal?  @default(0) @db.Decimal(20, 6)
  liquidity_clob    Decimal?  @default(0) @db.Decimal(20, 6)
  competitive       Int?      @default(0)
  comment_count     Int?      @default(0)
  markets           markets[]

  @@index([active], map: "idx_events_active")
  @@index([closed], map: "idx_events_closed")
  @@index([closed_time], map: "idx_events_closed_time")
  @@index([end_date], map: "idx_events_end_date")
  @@index([ticker], map: "idx_events_ticker")
  @@index([volume(sort: Desc)], map: "idx_events_volume")
}

model fetch_metadata {
  id           BigInt    @id @default(autoincrement())
  timestamp    DateTime  @db.Timestamptz(6)
  total_events Int?
  fetch_method String?
  filters      Json?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([timestamp(sort: Desc)], map: "idx_fetch_metadata_timestamp")
}

model markets {
  id                              String    @id
  event_id                        String
  question                        String
  condition_id                    String?
  slug                            String?
  question_id                     String?
  end_date                        DateTime? @db.Timestamptz(6)
  start_date                      DateTime? @db.Timestamptz(6)
  created_at                      DateTime? @db.Timestamptz(6)
  updated_at                      DateTime? @db.Timestamptz(6)
  closed_time                     DateTime? @db.Timestamptz(6)
  uma_end_date                    DateTime? @db.Timestamptz(6)
  accepting_orders_timestamp      DateTime? @db.Timestamptz(6)
  deploying_timestamp             DateTime? @db.Timestamptz(6)
  image                           String?
  icon                            String?
  description                     String?
  outcomes                        String?
  outcome_prices                  String?
  volume                          String?
  volume_num                      Decimal?  @default(0) @db.Decimal(20, 6)
  volume24hr                      Decimal?  @default(0) @db.Decimal(20, 6)
  volume1wk                       Decimal?  @default(0) @db.Decimal(20, 6)
  volume1mo                       Decimal?  @default(0) @db.Decimal(20, 6)
  volume1yr                       Decimal?  @default(0) @db.Decimal(20, 6)
  volume_clob                     Decimal?  @default(0) @db.Decimal(20, 6)
  volume24hr_clob                 Decimal?  @default(0) @db.Decimal(20, 6)
  volume1wk_clob                  Decimal?  @default(0) @db.Decimal(20, 6)
  volume1mo_clob                  Decimal?  @default(0) @db.Decimal(20, 6)
  volume1yr_clob                  Decimal?  @default(0) @db.Decimal(20, 6)
  liquidity                       String?
  liquidity_num                   Decimal?  @default(0) @db.Decimal(20, 6)
  liquidity_amm                   Decimal?  @default(0) @db.Decimal(20, 6)
  liquidity_clob                  Decimal?  @default(0) @db.Decimal(20, 6)
  active                          Boolean?  @default(false)
  closed                          Boolean?  @default(false)
  new                             Boolean?  @default(false)
  featured                        Boolean?  @default(false)
  archived                        Boolean?  @default(false)
  restricted                      Boolean?  @default(false)
  enable_order_book               Boolean?  @default(false)
  neg_risk                        Boolean?  @default(false)
  ready                           Boolean?  @default(false)
  funded                          Boolean?  @default(false)
  cyom                            Boolean?  @default(false)
  pager_duty_notification_enabled Boolean?  @default(false)
  approved                        Boolean?  @default(false)
  automatically_resolved          Boolean?  @default(false)
  automatically_active            Boolean?  @default(false)
  clear_book_on_start             Boolean?  @default(false)
  manual_activation               Boolean?  @default(false)
  neg_risk_other                  Boolean?  @default(false)
  pending_deployment              Boolean?  @default(false)
  deploying                       Boolean?  @default(false)
  rfq_enabled                     Boolean?  @default(false)
  holding_rewards_enabled         Boolean?  @default(false)
  fees_enabled                    Boolean?  @default(false)
  requires_translation            Boolean?  @default(false)
  accepting_orders                Boolean?  @default(false)
  has_reviewed_dates              Boolean?  @default(false)
  resolved_by                     String?
  uma_resolution_status           String?
  uma_resolution_statuses         String?
  uma_bond                        String?
  uma_reward                      String?
  market_maker_address            String?
  submitted_by                    String?
  group_item_title                String?
  group_item_threshold            String?
  clob_token_ids                  String?
  neg_risk_request_id             String?
  end_date_iso                    String?
  start_date_iso                  String?
  order_price_min_tick_size       Decimal?  @db.Decimal(10, 6)
  order_min_size                  Decimal?  @db.Decimal(20, 6)
  rewards_min_size                Decimal?  @db.Decimal(20, 6)
  rewards_max_spread              Decimal?  @db.Decimal(10, 6)
  spread                          Decimal?  @db.Decimal(10, 6)
  one_day_price_change            Decimal?  @db.Decimal(10, 6)
  one_week_price_change           Decimal?  @db.Decimal(10, 6)
  last_trade_price                Decimal?  @db.Decimal(10, 6)
  best_bid                        Decimal?  @db.Decimal(10, 6)
  best_ask                        Decimal?  @db.Decimal(10, 6)
  competitive                     Int?      @default(0)
  custom_liveness                 Int?      @default(0)
  events                          events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_event")

  @@index([closed], map: "idx_markets_closed")
  @@index([end_date], map: "idx_markets_end_date")
  @@index([event_id], map: "idx_markets_event_id")
  @@index([uma_resolution_status], map: "idx_markets_status")
  @@index([volume_num(sort: Desc)], map: "idx_markets_volume")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model redemptions {
  id               BigInt    @id @default(autoincrement())
  transaction_hash String
  condition_id     String?
  event_id         String?
  market_id        String?
  redeemer_address String
  payout_usdc      Decimal   @default(0) @db.Decimal(20, 6)
  timestamp_unix   BigInt
  timestamp_human  DateTime? @db.Timestamptz(6)
  market_question  String?
  event_title      String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([transaction_hash, redeemer_address], map: "unique_redemption")
  @@index([condition_id], map: "idx_redemptions_condition_id")
  @@index([event_id], map: "idx_redemptions_event_id")
  @@index([market_id], map: "idx_redemptions_market_id")
  @@index([payout_usdc(sort: Desc)], map: "idx_redemptions_payout")
  @@index([redeemer_address], map: "idx_redemptions_redeemer")
  @@index([timestamp_unix(sort: Desc)], map: "idx_redemptions_timestamp")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_closed_positions {
  id               BigInt    @id @default(autoincrement())
  proxy_wallet     String
  event_id         String?
  market_id        String?
  condition_id     String?
  asset            String?
  avg_price        Decimal?  @default(0) @db.Decimal(20, 6)
  total_bought     Decimal?  @default(0) @db.Decimal(20, 6)
  realized_pnl     Decimal?  @default(0) @db.Decimal(20, 6)
  cur_price        Decimal?  @default(0) @db.Decimal(20, 6)
  timestamp_unix   BigInt
  timestamp_human  DateTime? @db.Timestamptz(6)
  title            String?
  slug             String?
  icon             String?
  event_slug       String?
  outcome          String?
  outcome_index    Int?
  opposite_outcome String?
  opposite_asset   String?
  end_date         String?
  end_date_parsed  DateTime? @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([proxy_wallet, condition_id, asset, timestamp_unix], map: "unique_user_position")
  @@index([condition_id], map: "idx_user_closed_positions_condition")
  @@index([event_id], map: "idx_user_closed_positions_event_id")
  @@index([event_slug], map: "idx_user_closed_positions_event_slug")
  @@index([market_id], map: "idx_user_closed_positions_market_id")
  @@index([outcome_index], map: "idx_user_closed_positions_outcome")
  @@index([realized_pnl(sort: Desc)], map: "idx_user_closed_positions_realized_pnl")
  @@index([timestamp_unix(sort: Desc)], map: "idx_user_closed_positions_timestamp")
  @@index([proxy_wallet], map: "idx_user_closed_positions_wallet")
}

// ============================================================================
// NFT CLAIM SYSTEM - Новые модели для сбора Solana адресов
// ============================================================================

/// Модель для заявок на получение NFT
model NftClaim {
  id             Int       @id @default(autoincrement())
  ethAddress     String    @unique @map("eth_address") @db.VarChar(42)
  proxyWallet    String    @map("proxy_wallet") @db.VarChar(42)
  solanaAddress  String    @map("solana_address") @db.VarChar(44)
  status         ClaimStatus @default(PENDING)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  mintTxHash     String?   @map("mint_tx_hash") @db.VarChar(200)
  errorMessage   String?   @map("error_message") @db.Text

  @@index([status, createdAt], map: "idx_nft_claims_status_created")
  @@index([ethAddress], map: "idx_nft_claims_eth_address")
  @@map("nft_claims")
}

/// Enum для статусов заявки на NFT
enum ClaimStatus {
  PENDING       // Ожидает обработки
  PROCESSING    // В процессе минта
  COMPLETED     // NFT успешно получен
  FAILED        // Ошибка при минте
}

/// Модель для rate limiting
model RateLimit {
  id           Int      @id @default(autoincrement())
  identifier   String   @unique @db.VarChar(100)
  count        Int      @default(0)
  windowStart  DateTime @default(now()) @map("window_start") @db.Timestamptz(6)
  
  @@index([identifier], map: "idx_rate_limits_identifier")
  @@map("rate_limits")
}
