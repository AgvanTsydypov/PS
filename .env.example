# Секретный ключ для iron-session (сгенерируйте случайную строку минимум 32 символа)
SESSION_SECRET=your-secret-key-min-32-characters-long

# URL приложения
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wallet Connect Project ID (получите на https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id
