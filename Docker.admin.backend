FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends \
    nodejs \
    libvulkan1 \
    mesa-vulkan-drivers \
    vulkan-tools \
    libdbus-1-3 \
    libglib2.0-0 \
    libx11-6 \
    libxext6 \
    libxrandr2 \
    libxrender1 \
    libxfixes3 \
    libxi6 \
    libxinerama1 \
    libxcursor1 \
    libxkbcommon0 \
    libwayland-client0 \
    libwayland-egl1 \
    libegl1 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && \
    playwright install chromium && \
    playwright install-deps chromium

COPY package.json package-lock.json /app/
RUN npm ci --omit=dev

COPY scripts /app/scripts
COPY admin_backend /app/admin_backend
COPY sql /app/sql
COPY data /app/data
RUN if [ -f /app/admin_backend/GeminiWatermarkToolLinux ]; then chmod +x /app/admin_backend/GeminiWatermarkToolLinux; fi

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8001

CMD ["uvicorn", "admin_backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
